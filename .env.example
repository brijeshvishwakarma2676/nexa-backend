# SocialConnect Backend Environment Variables
# Copy this file to .env and update the values

# App Settings
APP_NAME=SocialConnect
DEBUG=True

# Database
# SQLite (default for development)
DATABASE_URL=sqlite+aiosqlite:///./social.db
# PostgreSQL (for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/socialconnect

# JWT Authentication
# IMPORTANT: Change this to a secure random string in production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (comma-separated for multiple origins)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Redis (optional - for session caching and real-time features)
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=

# Upstash Redis (for keep-alive and preventing server sleep)
UPSTASH_REDIS_URL=redis://default:password@your-instance.upstash.io:6379

# Stories
STORY_EXPIRY_HOURS=24
